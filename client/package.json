{
  "name": "astra-browser",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "node --disable-warning=ESLintIgnoreWarning node_modules/@angular/cli/bin/ng.js lint",
    "lint:fix": "node --disable-warning=ESLintIgnoreWarning node_modules/@angular/cli/bin/ng.js lint --fix",
    "lint:ox": "oxlint --deny-warnings",
    "lint:ox:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "i18n:check": "node scripts/i18n-check.mjs",
    "icons": "node scripts/icons.mjs",
    "tauri:dev": "cd ../server && tauri dev --config tauri.dev.conf.json",
    "tauri:build": "cd ../server && tauri build",
    "release": "node scripts/release.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@tauri-apps/api": "^2.12.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.90.0",
    "jsdom": "30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.5"
  }
}
