{
  "name": "astra-browser",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "node --disable-warning=ESLintIgnoreWarning node_modules/@angular/cli/bin/ng.js lint",
    "lint:fix": "node --disable-warning=ESLintIgnoreWarning node_modules/@angular/cli/bin/ng.js lint --fix",
    "lint:ox": "oxlint --deny-warnings",
    "lint:ox:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "i18n:check": "node scripts/i18n-check.mjs",
    "icons": "node scripts/icons.mjs",
    "tauri:dev": "node scripts/clean-target.mjs && cd ../server && tauri dev --config tauri.dev.conf.json",
    "tauri:build": "node scripts/clean-target.mjs && cd ../server && tauri build",
    "release": "node scripts/release.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@tauri-apps/api": "^2.12.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.6",
    "angular-eslint": "22.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-oxlint": "^1.94.0",
    "jsdom": "31.0.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "stylelint": "^18.1.0",
    "stylelint-config-recess-order": "^7.10.1",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.1"
  }
}
