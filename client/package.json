{
  "name": "astra-browser",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "node --disable-warning=ESLintIgnoreWarning node_modules/@angular/cli/bin/ng.js lint",
    "lint:fix": "node --disable-warning=ESLintIgnoreWarning node_modules/@angular/cli/bin/ng.js lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/**/*.scss\" --fix",
    "tauri:dev": "cd ../server && tauri dev",
    "tauri:build": "cd ../server && tauri build",
    "release": "node scripts/release.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@tauri-apps/api": "^2.12.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.3"
  }
}
