{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astra Browser",
  "version": "0.1.13",
  "identifier": "com.astrabrowser.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix client run start -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:4200",
    "beforeBuildCommand": "npm --prefix client run build",
    "frontendDist": "../client/dist/astra-browser/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Astra Browser",
        "width": 1280,
        "height": 800,
        "center": true,
        "maximized": true,
        "decorations": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI",
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'self' data: blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxRUQ0NzkzQzgzM0RDNjUKUldSbDNEUElrMGZ0c2J1TzgzRlZpekxmZUVTclA0MlpwOTlFVDlsVm1LODJJZGFQS3dXcGljZjAK",
      "endpoints": ["https://github.com/RomanNikolaenko/AstraBrowser/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
